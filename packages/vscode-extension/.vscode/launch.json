// A launch configuration that compiles the extension and then opens it inside a new window
// Use IntelliSense to learn about possible attributes.
// Hover to view descriptions of existing attributes.
// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Run Extension",
			"type": "extensionHost",
			"request": "launch",
			// Cursor can leave the extension host stopped on the first line (debugBrk) while the
			// debugger never attaches in time → "Extension host did not start in 10 seconds" and
			// no activation / no Debug Console logs. VS Code often attaches fast enough to hide it.
			"stopOnEntry": false,
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}"
			],
			"outFiles": [
				"${workspaceFolder}/dist/**/*.js"
			],
			"preLaunchTask": "build:all"
		}
	]
}
